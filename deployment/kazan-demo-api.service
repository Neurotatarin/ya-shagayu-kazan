[Unit]
Description=Ya Shagayu Kazan isolated demo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=kazan-demo
StateDirectoryMode=0700
Environment=KAZAN_STATE=/var/lib/kazan-demo
Environment=KAZAN_PORT=8792
EnvironmentFile=/etc/kazan-demo/api.env
ExecStart=/usr/bin/python3 -u /opt/kazan-demo/current/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=128M
CPUQuota=40%
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
